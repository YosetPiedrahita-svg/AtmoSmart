# Copie este archivo como .env y complete los valores. NUNCA suba .env al repositorio.

# Puerto del servidor HTTP
PORT=3000

# Supabase (Settings → API en el panel del proyecto).
# Si se dejan vacíos, el backend usa almacenamiento EN MEMORIA (útil para pruebas).
SUPABASE_URL=
# Clave de servicio (service_role): solo para el backend, jamás en el frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Token opcional que deben enviar los sensores/simulador en la cabecera x-api-key
INGESTA_TOKEN=

# Segundos sin datos para considerar un equipo "sin señal"
SIN_SENAL_SEGUNDOS=60
# Minutos de horizonte para alertas predictivas por tendencia
HORIZONTE_PREDICTIVO_MIN=30
